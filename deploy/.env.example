# Copy to deploy/.env on the host. Never commit the real file.
# Image tag to run. Manual installs: a released version (e.g. 0.1.0) or `latest`.
# promote.yml overrides this per run with the digest-pinned images staging ran.
SAHIFA_TAG=latest
# Public hostname for automatic TLS (leave empty to serve plain HTTP on :80)
SAHIFA_DOMAIN=
# Required; the API refuses to start in prod with a "change-me" value or another placeholder.
# It sits inside the database URL: generate it with `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
# The address people open, https, no path (e.g. https://sahifa.example.com).
SAHIFA_PUBLIC_URL=

# Sign-in (spec 006, deploy/caprover.md section 4a). In prod the API starts only with one of:
#  a) SAHIFA_AUTH_MODE=oidc and the Keycloak settings below (the default when no gate is set);
#  b) SAHIFA_AUTH_MODE=proxy and SAHIFA_ACCESS_GATE=basic-auth-at-proxy, set only once your load
#     balancer or reverse proxy really enforces HTTP basic auth for every path.
# dev is refused in prod.
SAHIFA_AUTH_MODE=
SAHIFA_ACCESS_GATE=
# The realm, e.g. https://miftachun.apps.data-and-ai-dude.ch/realms/sahifa
SAHIFA_OIDC_ISSUER=
SAHIFA_OIDC_CLIENT_ID=sahifa-api
# The sahifa-api client's secret (Keycloak → Clients → sahifa-api → Credentials).
SAHIFA_OIDC_CLIENT_SECRET=
# Keys the stored session hashes; at least 32 characters: `openssl rand -hex 32`.
SAHIFA_SESSION_SECRET=
# The administrator's address (always has access) and optional further addresses, comma-separated.
# Everyone else who signs in sees "No access yet".
SAHIFA_ADMIN_EMAIL=
SAHIFA_ALLOWED_EMAILS=
SAHIFA_SIGN_IN_METHODS=google,github,passkey
SAHIFA_SESSION_IDLE=12h
SAHIFA_SESSION_ABSOLUTE=30d

# Optional limits (defaults shown).
# Rows per table or file the profile and checks see; 0 reads everything.
SAHIFA_SAMPLE_ROWS=100000
SAHIFA_MAX_UPLOAD_MB=200
SAHIFA_MAX_UPLOAD_FILES=20
# The whole upload request, all files together, and the free disk an upload must leave (spec 012).
SAHIFA_MAX_UPLOAD_TOTAL_MB=1024
SAHIFA_MIN_FREE_DISK_MB=1024
# Requests per session or address; scans one user may start per hour. `off` behind a gateway
# that limits already.
SAHIFA_RATE_LIMITS=on
SAHIFA_RATE_SCANS_PER_HOUR=60
# /api/docs and /api/openapi.json; unset means on outside prod, off in prod.
# SAHIFA_API_DOCS=off
# Uploaded files are deleted this many days after their scan finished (hourly clean-up).
SAHIFA_UPLOAD_TTL_DAYS=7
# Scans at once, run by the worker service (compose.yaml sets SAHIFA_SCAN_EXECUTION=queue on
# the api and the worker; inline, the api runs scans itself and needs no worker).
SAHIFA_MAX_CONCURRENT_SCANS=2
# A worker silent this long counts as stopped; the reaper then fails its running scans.
SAHIFA_REAPER_STALE_MINUTES=10
# A connection's schedule may not run more often than this (spec 010); it protects the sources.
SAHIFA_SCHEDULE_MIN_INTERVAL_MINUTES=60
# Postgres sessions one scan uses to scan tables at once (spec 013); each is read-only.
SAHIFA_SCAN_WORKERS=2
# Memory DuckDB may use per scan; the container needs this times the concurrent scans, plus headroom.
SAHIFA_DUCKDB_MEMORY=1GB
# Per statement against a source; Sahifa also sets a lock timeout and read-only transactions.
SAHIFA_STATEMENT_TIMEOUT_S=60
SAHIFA_LOG_LEVEL=info

# Sources to assess (ADR-0006): one variable per Postgres database, SAHIFA_CONN_<NAME>. The
# api registers a connection named <name> in lower case at start. Use a read-only login
# (deploy/caprover.md, section 6); credentials never leave this file for Sahifa's database.
# SAHIFA_CONN_SHOP=postgresql://sahifa_reader:<password>@db.example.com:5432/shop?schemas=public,sales
