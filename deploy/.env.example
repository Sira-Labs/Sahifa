# Copy to deploy/.env on the host. Never commit the real file.
# Image tag to run. Manual installs: a released version (e.g. 0.1.0) or `latest`.
# promote.yml overrides this per run with the digest-pinned images staging ran.
SAHIFA_TAG=latest
# Public hostname for automatic TLS (leave empty to serve plain HTTP on :80)
SAHIFA_DOMAIN=
# Required; the API refuses to start in prod with a "change-me" value or another placeholder.
# It sits inside the database URL: generate it with `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
# The address people open, https, no path (e.g. https://sahifa.example.com).
SAHIFA_PUBLIC_URL=
# Until sign-in arrives in R2 (ADR-0010) the API refuses to start in prod unless this says
# that a proxy in front asks for a password. Set it to `basic-auth-at-proxy` only once your
# load balancer or reverse proxy really enforces HTTP basic auth for every path.
SAHIFA_ACCESS_GATE=

# Optional limits (defaults shown).
# Rows per table or file the profile and checks see; 0 reads everything.
SAHIFA_SAMPLE_ROWS=100000
SAHIFA_MAX_UPLOAD_MB=200
SAHIFA_MAX_UPLOAD_FILES=20
# Uploaded files are deleted after this many days.
SAHIFA_UPLOAD_TTL_DAYS=7
SAHIFA_MAX_CONCURRENT_SCANS=2
# Memory DuckDB may use per scan; the container needs this times the concurrent scans, plus headroom.
SAHIFA_DUCKDB_MEMORY=1GB
# Per statement against a source; Sahifa also sets a lock timeout and read-only transactions.
SAHIFA_STATEMENT_TIMEOUT_S=60
SAHIFA_LOG_LEVEL=info

# Sources to assess (ADR-0006): one variable per Postgres database, SAHIFA_CONN_<NAME>. The
# api registers a connection named <name> in lower case at start. Use a read-only login
# (deploy/caprover.md, section 6); credentials never leave this file for Sahifa's database.
# SAHIFA_CONN_SHOP=postgresql://sahifa_reader:<password>@db.example.com:5432/shop?schemas=public,sales
